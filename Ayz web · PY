                const div = document.createElement('div');
                div.className = 'message';
                div.innerHTML = `<div class="avatar" style="background:${color}">${name[0]}</div><div class="content">${text}</div>`;
                messages.appendChild(div);
                messages.scrollTop = messages.scrollHeight;
            }

            function showTyping() {
                const div = document.createElement('div');
                div.className = 'message';
                div.id = 'typing';
                div.innerHTML = `<div class="avatar" style="background:linear-gradient(135deg,#4488ff,#ff3344,#00ff88)">AYZ</div><div class="content"><div class="typing"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></div>`;
                messages.appendChild(div);
                messages.scrollTop = messages.scrollHeight;
            }

            function removeTyping() {
                const el = document.getElementById('typing');
                if (el) el.remove();
            }
        </script>
    </body>
    </html>
    """


@app.route("/api/chat", methods=["POST"])
def chat():
    global chat_history
    config = load_config()
    host = config.get("ollama_host", "http://localhost:11434")
    model = config.get("ollama_model", "llama3.1")
    system_prompt = config.get("system_prompt", DEFAULT_SYSTEM_PROMPT)
    message = (request.json or {}).get("message", "")

    if not message.strip():
        return jsonify({"response": "Lütfen bir mesaj yazın."})

    messages = [{"role": "system", "content": system_prompt}]
    for turn in chat_history[-10:]:
        messages.append({"role": "user", "content": turn["user"]})
        messages.append({"role": "assistant", "content": turn["ai"]})
    messages.append({"role": "user", "content": message})

    try:
        r = requests.post(
            f"{host}/api/chat",
            json={"model": model, "messages": messages, "stream": False},
            timeout=120,
        )
        r.raise_for_status()
        data = r.json()
        reply = data.get("message", {}).get("content", "").strip()
    except requests.exceptions.ConnectionError:
        return jsonify(
            {"response": f"⚠️ Ollama'ya bağlanılamadı ({host}). 'ollama serve' çalışıyor mu kontrol et."}
        )
    except requests.exceptions.Timeout:
        return jsonify({"response": "⚠️ Model yanıt vermekte gecikti (timeout)."})
    except Exception as e:
        return jsonify({"response": f"⚠️ Hata: {str(e)}"})

    chat_history.append({"user": message, "ai": reply})
    return jsonify({"response": reply})


@app.route("/api/reset", methods=["POST"])
def reset():
    global chat_history
    chat_history = []
    return jsonify({"status": "ok"})


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)