from flask import Flask, request, jsonify
from flask_cors import CORS
import json
import requests
from pathlib import Path

app = Flask(__name__)
CORS(app)

BASE_DIR = Path(__file__).resolve().parent

DEFAULT_SYSTEM_PROMPT = (
    "Sen AYZ adında yardımsever bir yapay zeka asistanısın. "
    "Rol yapma senaryolarında karaktere sadık kal, akıcı ve doğal bir üslup kullan."
)

# Basit, tek kullanıcılı bellek-içi sohbet geçmişi (sunucu yeniden başlayınca sıfırlanır)
chat_history = []


def load_config():
    try:
        with open(BASE_DIR / "ayz_config.json", "r", encoding="utf-8") as f:
            config = json.load(f)
    except Exception:
        config = {}
    config.setdefault("ollama_host", "http://localhost:11434")
    config.setdefault("ollama_model", "llama3.1")
    config.setdefault("system_prompt", DEFAULT_SYSTEM_PROMPT)
    return config


@app.route("/")
def index():
    return """
    <!DOCTYPE html>
    <html>
    <head>
        <title>AYZ - Yapay Zeka Asistanı</title>
        <style>
            * { margin:0; padding:0; box-sizing:border-box; }
            body { font-family: system-ui, sans-serif; background:#0a0a0f; color:#e0e0e0; height:100vh; display:flex; flex-direction:column; }
            .topbar { background:#12121a; padding:16px 28px; border-bottom:1px solid #2a2a3a; display:flex; align-items:center; gap:12px; }
            .logo { font-size:28px; font-weight:800; }
            .a { color:#4488ff; } .y { color:#ff3344; } .z { color:#00ff88; }
            .badge { font-size:11px; color:#666; background:#1a1a2a; padding:4px 12px; border-radius:20px; }
            .reset-btn { margin-left:auto; background:#1a1a2a; border:1px solid #2a2a3a; color:#999; padding:6px 14px; border-radius:8px; cursor:pointer; font-size:12px; }
            .reset-btn:hover { color:#e0e0e0; }
            .messages { flex:1; overflow-y:auto; padding:20px; }
            .message { display:flex; padding:12px 0; gap:12px; }
            .avatar { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; background:#2a2a3a; }
            .ai .avatar { background:linear-gradient(135deg,#4488ff,#ff3344,#00ff88); }
            .content { line-height:1.7; max-width:80%; }
            .input-area { padding:16px 20px; background:#0a0a0f; border-top:1px solid #1a1a2a; }
            .input-wrapper { max-width:850px; margin:auto; display:flex; gap:8px; background:#12121a; border:1px solid #2a2a3a; border-radius:16px; padding:8px 12px; }
            textarea { flex:1; background:transparent; border:none; outline:none; color:#e0e0e0; font-size:15px; resize:none; padding:8px 0; }
            .send { background:linear-gradient(135deg,#4488ff,#ff3344,#00ff88); border:none; border-radius:12px; color:#fff; padding:8px 20px; cursor:pointer; font-size:16px; }
            .send:hover { opacity:0.9; }
            .typing { display:flex; gap:4px; padding:4px 0; }
            .dot { width:8px; height:8px; background:#666; border-radius:50%; animation:bounce 1.4s infinite; }
            .dot:nth-child(2) { animation-delay:.2s; }
            .dot:nth-child(3) { animation-delay:.4s; }
            @keyframes bounce { 0%,60%,100% { transform:translateY(0); } 30% { transform:translateY(-6px); } }
        </style>
    </head>
    <body>
        <div class="topbar">
            <div class="logo"><span class="a">A</span><span class="y">Y</span><span class="z">Z</span></div>
            <span class="badge">YAPAY ZEKA · OLLAMA</span>
            <button class="reset-btn" onclick="resetChat()">Sohbeti sıfırla</button>
        </div>
        <div class="messages" id="messages">
            <div class="message ai">
                <div class="avatar">AYZ</div>
                <div class="content">Merhaba! 👋 Size nasıl yardımcı olabilirim?</div>
            </div>
        </div>
        <div class="input-area">
            <div class="input-wrapper">
                <textarea id="input" placeholder="Mesajınızı yazın..." rows="1"></textarea>
                <button class="send" onclick="send()">↑</button>
            </div>
        </div>
        <script>
            const messages = document.getElementById('messages');
            const input = document.getElementById('input');

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
            });

            async function send() {
                const text = input.value.trim();
                if (!text) return;
                input.value = '';
                addMessage('Siz', text, '#2a2a3a');
                showTyping();
                try {
                    const res = await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: text })
                    });
                    const data = await res.json();
                    removeTyping();
                    addMessage('AYZ', data.response, 'linear-gradient(135deg,#4488ff,#ff3344,#00ff88)');
                } catch {
                    removeTyping();
                    addMessage('AYZ', 'Bağlantı hatası!', 'linear-gradient(135deg,#4488ff,#ff3344,#00ff88)');
